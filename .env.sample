# Copy to .env and set values
PORT=8080
OPENAI_API_KEY=replace_me
LOG_LEVEL=info

# Anthropic / Claude (content generation v2 route)
ANTHROPIC_API_KEY=replace_me
ANTHROPIC_MODEL=claude-opus-4-8

# Flux AI Configuration
FLUX_AI_API_KEY=your_flux_ai_api_key_here

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# ── Billing & notifications (BILL-001…009) ───────────────────────────────────
# Every one is OPTIONAL and shown with its default. The defaults are what runs
# if you set nothing.

# Billing receipts (upgrade, cancellation). ON by default — the ticket's
# complaint is that no email is sent, so shipping it off would relocate the bug.
# Set false to halt delivery; jobs keep queueing and are sent when re-enabled.
BILLING_EMAILS_ENABLED=true

# Credit-expiry + inactivity emails. OFF until the copy owner supplies final
# text — the templates carry "[PLACEHOLDER]" in the subject line.
LIFECYCLE_EMAILS_ENABLED=false

# Hourly check for billing events with no ledger row. Turn ON after running
# `npm run backfill:transactions`, or it will report the pre-existing gap.
LEDGER_MONITOR_ENABLED=false

# Lead times for the credit-expiry warning, in days before expiry.
CREDIT_EXPIRY_LEAD_DAYS=14,3,0

# Inactivity: consecutive days with no generation, and the minimum gap between
# successive nudges to one user.
INACTIVITY_EMAIL_DAYS=14
INACTIVITY_COOLDOWN_DAYS=60

# Where email links point.
CMS_BASE_URL=https://account.improveseoplugin.com

# Tuning. Defaults are fine.
# NOTIFICATION_BATCH_SIZE=100
# NOTIFICATION_INTERVAL_MS=86400000
# EMAIL_WORKER_INTERVAL_MS=60000
# LEDGER_MONITOR_GRACE_MINUTES=15

# ─── Admin access ─────────────────────────────────────────────────────────────
# Comma-separated emails allowed to reach /api/admin and /api/v1/admin/users.
# FAILS CLOSED: unset or empty means nobody is an admin and every admin route 403s.
# There is no runtime write path — changing the admin set requires a redeploy.
ADMIN_EMAILS=

# ─── ISEO Credits: deduction table ────────────────────────────────────────────
# ISEO Credits charged per action.
#
# PM-TUNABLE: these are plain numbers. Changing one is an env change on Render
# followed by a redeploy — no code change and no logic redeploy. The values live
# in env precisely so pricing can move without touching the money path.
#
# Positive integers only. The server REFUSES TO START if any is missing or
# malformed: a server that cannot price an action must not serve one, and a
# silent fallback to 0 would hand out free generations. There are deliberately
# NO in-code defaults — env is the only way these reach a running process.
#
# Cost-derived and stable; a medium article is the unit (10 credits ~= $0.129).
ISEO_COST_CONTENT_SMALL=6
ISEO_COST_CONTENT_MEDIUM=10
ISEO_COST_CONTENT_LARGE=14

# Regeneration. A regen costs US the same as a first generation (there is no
# partial-regen path), so this discount is a pricing decision, not a cost
# calculation. ~60% of first-gen.
ISEO_COST_CONTENT_REGEN_SMALL=4
ISEO_COST_CONTENT_REGEN_MEDIUM=6
ISEO_COST_CONTENT_REGEN_LARGE=8

ISEO_COST_IMAGE=5
ISEO_COST_IMAGE_REGEN=3

ISEO_COST_KEYWORDS=1

# ─── ISEO Credits: plan grants ────────────────────────────────────────────────
# Credits granted per billing cycle, keyed by subscription_plans.slug. Synced
# into subscription_plans.*_credits at boot, so legacy readers (Stripe checkout
# descriptions, CMS plan tables) keep showing the real number.
#
# PM-TUNABLE, same as above: env change + redeploy, no logic change.
#
# PLACEHOLDER VALUES — PM to confirm against real retail prices using:
#   credits = (plan_price * target_COGS_share) / 0.0129
# where $0.0129 is the per-credit cost implied by a medium article at $0.129.
# The values below are derived at a 30% COGS share and rounded; they are a
# starting point, not a pricing decision.
#
# THE KEYS MUST MATCH subscription_plans.slug EXACTLY. These four are the real
# production slugs. A slug with no matching key silently falls back to the FREE
# grant, which would hand paying customers the free allotment. Note the
# 950-cent plan's slug is 'basic' even though its display name is "Grow".
ISEO_GRANT_FREE=100
ISEO_GRANT_BASIC=220
ISEO_GRANT_STARTER=580
ISEO_GRANT_PRO=1150

# ── Top-up packages ──────────────────────────────────────────────────────────
# Sized in PIECES of finished content (~19 credits each: article 10 + image 5 +
# keyword list 1, plus a 30%/40% rerun allowance) → roughly 3, 5 and 10 pieces.
# Prices sit above the subscription rate of ~$0.043/credit, with a volume
# discount. CONFIRM THESE BEFORE LAUNCH — they are proposals, not signed off.
ISEO_PACKAGE_SMALL_CREDITS=60
ISEO_PACKAGE_SMALL_PRICE_CENTS=399
ISEO_PACKAGE_MEDIUM_CREDITS=100
ISEO_PACKAGE_MEDIUM_PRICE_CENTS=599
ISEO_PACKAGE_LARGE_CREDITS=200
ISEO_PACKAGE_LARGE_PRICE_CENTS=1099

# Yearly billing: months free when paying annually (2 = "two months free").
ISEO_YEARLY_FREE_MONTHS=2
