# Copy to .env and set values
PORT=8080
OPENAI_API_KEY=replace_me
LOG_LEVEL=info

# Anthropic / Claude (content generation v2 route)
ANTHROPIC_API_KEY=replace_me
ANTHROPIC_MODEL=claude-opus-4-8

# Flux AI Configuration
FLUX_AI_API_KEY=your_flux_ai_api_key_here

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# ── Billing & notifications (BILL-001…009) ───────────────────────────────────
# Every one is OPTIONAL and shown with its default. The defaults are what runs
# if you set nothing.

# Billing receipts (upgrade, cancellation). ON by default — the ticket's
# complaint is that no email is sent, so shipping it off would relocate the bug.
# Set false to halt delivery; jobs keep queueing and are sent when re-enabled.
BILLING_EMAILS_ENABLED=true

# Credit-expiry + inactivity emails. OFF until the copy owner supplies final
# text — the templates carry "[PLACEHOLDER]" in the subject line.
LIFECYCLE_EMAILS_ENABLED=false

# Hourly check for billing events with no ledger row. Turn ON after running
# `npm run backfill:transactions`, or it will report the pre-existing gap.
LEDGER_MONITOR_ENABLED=false

# Lead times for the credit-expiry warning, in days before expiry.
CREDIT_EXPIRY_LEAD_DAYS=14,3,0

# Inactivity: consecutive days with no generation, and the minimum gap between
# successive nudges to one user.
INACTIVITY_EMAIL_DAYS=14
INACTIVITY_COOLDOWN_DAYS=60

# Where email links point.
CMS_BASE_URL=https://account.improveseoplugin.com

# Tuning. Defaults are fine.
# NOTIFICATION_BATCH_SIZE=100
# NOTIFICATION_INTERVAL_MS=86400000
# EMAIL_WORKER_INTERVAL_MS=60000
# LEDGER_MONITOR_GRACE_MINUTES=15
