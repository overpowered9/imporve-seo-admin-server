# Keyword data (DataForSEO Labs) — see src/config/keyword-data.config.ts and docs/KEYWORD_DATA_V3.md.
# Keys only, no values. Every other variable the server reads is listed in src/config/config.ts and
# the envSchema in src/config/credits.config.ts (commit edffa9a chose the config as the source of
# truth; this file exists because the keyword data work asked for a .env.example).

# DataForSEO Basic-auth credentials. Missing → keyword metrics answer 503 and the v3 Title/Planner
# steps run exactly as without keyword data.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Option B master switch. Only the literal "true" turns it on, and a request must ALSO send
# use_keyword_data: true.
ISEO_V3_KEYWORD_DATA=

# ISEO credits charged per POST /generate/keywords/metrics request. Default 0 (free). Open decision.
KEYWORD_METRICS_CREDIT_COST=

# Optional: USD per million tokens, so the A/B harness can report model cost next to token counts.
# Unset → the harness reports tokens only and model_cost_usd: null.
AB_MODEL_PRICE_INPUT_PER_MTOK=
AB_MODEL_PRICE_OUTPUT_PER_MTOK=
