# ImproveSEO server — every environment variable the code reads, keys only, no values (OPS7).
# "REQUIRED" = the server refuses to boot without it (credits.config.ts / db.ts / config.ts).
# Secrets live ONLY here (the host's env), never in the plugin and never in a log line.

# ── Core ──────────────────────────────────────────────────────────────────────────────────────────
PORT=
NODE_ENV=
# REQUIRED. Postgres (Supabase) connection string.
DATABASE_URL=
# REQUIRED. Prompt templates and versions.
MONGODB_URI=
CORS_ORIGIN=
FRONTEND_URL=
PUBLIC_API_URL=
CMS_BASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_IMAGE_BUCKET=
# Set by Render; echoed by /health.
RENDER_GIT_BRANCH=
RENDER_GIT_COMMIT=
# off | log (default) | enforce — the site_code vs domain check in plugin auth.
ISEO_DOMAIN_ENFORCEMENT=

# ── Admin panel ───────────────────────────────────────────────────────────────────────────────────
ADMIN_EMAILS=
ADMIN_PASSWORD=
ADMIN_SESSION_HOURS=

# ── Models ────────────────────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Low-cost model (v2 intelligence/meta; v3 Planner). Default claude-opus-4-8.
ANTHROPIC_MODEL=
# Writing model (v2 writer/humanizer; v3 Title and Writer). Default claude-opus-4-8.
ANTHROPIC_WRITE_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_IMAGE_MODEL=
FLUX_AI_API_KEY=
USE_ENHANCED_AI=
# Optional JSON price table override for the per-call cost log (services/model-pricing.ts), e.g.
# {"claude-sonnet-5":{"input":2,"output":10,"cache_write":2.5,"cache_read":0.2}}  (USD per MTok)
MODEL_PRICES_JSON=

# ── Content v3 (config/content-v3.config.ts, docs/CONTENT_V3.md) ──────────────────────────────────
# Master switch. Only the literal "true" turns it on, and a site's plugin setting "Use Content v3"
# must ALSO be on. Unset/anything else = every site uses v2 (this is the rollback).
CONTENT_V3_ENABLED=
# Attempts per model step (1-3, default 3).
CONTENT_V3_MAX_ATTEMPTS=
# Per-attempt timeouts in ms (defaults: 30000 / 60000 / 120000 / 90000 / 300000 / 60000).
CONTENT_V3_TIMEOUT_SEARCH_DATA_MS=
CONTENT_V3_TIMEOUT_TITLE_MS=
CONTENT_V3_TIMEOUT_RESEARCH_MS=
CONTENT_V3_TIMEOUT_PLANNER_MS=
CONTENT_V3_TIMEOUT_WRITER_MS=
CONTENT_V3_TIMEOUT_META_MS=
# Abandoned wizard sessions are purged after this many days (default 7).
CONTENT_V3_SESSION_TTL_DAYS=
# Word-target calibration per size (decision 14 Nov): the Writer's targets are multiplied by these.
# JSON, each 0.5–2.5; default {"small":1.0,"medium":1.3,"large":1.6}.
CONTENT_V3_TARGET_CALIBRATION_JSON=
# LOCAL DEVELOPMENT ONLY: "memory" keeps sessions in the process instead of Postgres. Never on Render.
CONTENT_V3_STORE=
# Search data lookup (config/search-data.config.ts). Uses DATAFORSEO_LOGIN / DATAFORSEO_PASSWORD.
# Thin = fewer than this many People Also Ask questions OR related searches (default 3).
SEARCH_DATA_THIN_THRESHOLD=
# The country-level call (defaults 2840 / us / United States).
SEARCH_DATA_COUNTRY_CODE=
SEARCH_DATA_COUNTRY_ISO=
SEARCH_DATA_COUNTRY_NAME=
# Towns DataForSEO does not list → nearest listed location, e.g. {"Chimayo, NM":"Espanola,New Mexico,United States"}
SEARCH_DATA_TOWN_ALIASES_JSON=
# Research (PROMPT 2) on the Perplexity Agent API (config/research.config.ts). No key → research is
# skipped and the article is written without facts (the doc's fallback).
PERPLEXITY_API_KEY=
# Open question for Zaid; working value low. fast | low | medium | high.
PERPLEXITY_EFFORT=
# Optional model id; unset = the effort preset's model.
PERPLEXITY_MODEL=
# web_search max_results (default 20) and the answer's max_output_tokens (default 4000).
PERPLEXITY_MAX_RESULTS=
PERPLEXITY_MAX_OUTPUT_TOKENS=
# Extra domains never put in the competitor denylist (comma-separated).
RESEARCH_FILTER_SKIP_DOMAINS=

# ── Keyword data (DataForSEO Labs) — config/keyword-data.config.ts, docs/KEYWORD_DATA_V3.md ───────
# DataForSEO Basic-auth credentials. Missing → keyword metrics answer 503 and the v3 Title/Planner
# steps run exactly as without keyword data.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Option B master switch. Only the literal "true" turns it on, and a request must ALSO send
# use_keyword_data: true.
ISEO_V3_KEYWORD_DATA=
# ISEO credits charged per POST /generate/keywords/metrics request. Default 0 (free). Open decision.
KEYWORD_METRICS_CREDIT_COST=
# Optional: USD per million tokens, so the A/B harness can report model cost next to token counts.
# Unset → the harness reports tokens only and model_cost_usd: null.
AB_MODEL_PRICE_INPUT_PER_MTOK=
AB_MODEL_PRICE_OUTPUT_PER_MTOK=

# ── Credits (config/credits.config.ts) — all REQUIRED ─────────────────────────────────────────────
ISEO_COST_CONTENT_SMALL=
ISEO_COST_CONTENT_MEDIUM=
ISEO_COST_CONTENT_LARGE=
ISEO_COST_CONTENT_REGEN_SMALL=
ISEO_COST_CONTENT_REGEN_MEDIUM=
ISEO_COST_CONTENT_REGEN_LARGE=
ISEO_COST_IMAGE=
ISEO_COST_IMAGE_REGEN=
ISEO_COST_KEYWORDS=
ISEO_GRANT_FREE=
ISEO_GRANT_BASIC=
ISEO_GRANT_STARTER=
ISEO_GRANT_PRO=
ISEO_PACKAGE_SMALL_CREDITS=
ISEO_PACKAGE_SMALL_PRICE_CENTS=
ISEO_PACKAGE_SMALL_PRICE_CENTS_FREE=
ISEO_PACKAGE_MEDIUM_CREDITS=
ISEO_PACKAGE_MEDIUM_PRICE_CENTS=
ISEO_PACKAGE_MEDIUM_PRICE_CENTS_FREE=
# Optional (defaulted in code).
ISEO_PLAN_CREDIT_LIFETIME_MONTHS=
ISEO_PURCHASED_CREDIT_LIFETIME_MONTHS=
ISEO_YEARLY_FREE_MONTHS=
CREDIT_EXPIRY_LEAD_DAYS=
BILLING_PRORATED_CREDITS_ENABLED=
LEDGER_MONITOR_ENABLED=
LEDGER_MONITOR_GRACE_MINUTES=

# ── Stripe ────────────────────────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ── Email ─────────────────────────────────────────────────────────────────────────────────────────
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=
MAILGUN_FROM_NAME=
EMAIL_LOGO_URL=
EMAIL_WORKER_INTERVAL_MS=
BILLING_EMAILS_ENABLED=
LIFECYCLE_EMAILS_ENABLED=
TRIAL_EMAILS_ENABLED=
TRIAL_EMAIL_FROM=
TRIAL_EMAIL_FROM_EMAIL=
TRIAL_EMAIL_FROM_NAME=
TRIAL_EMAIL_REPLY_TO=
INACTIVITY_EMAIL_DAYS=
INACTIVITY_COOLDOWN_DAYS=
NOTIFICATION_BATCH_SIZE=
NOTIFICATION_INTERVAL_MS=
