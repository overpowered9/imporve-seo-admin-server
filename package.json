{
  "name": "improveseo-ai-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "init": "tsx src/scripts/initializeSystem.ts",
    "seed": "tsx src/scripts/seedFixedTemplates.ts",
    "seed:content-v2": "tsx src/scripts/seed-content-v2-prompts.ts",
    "migrate:notifications": "tsx src/migrations/002-user-notifications.ts",
    "migrate:address": "tsx src/migrations/003-user-address.ts",
    "migrate:billing-transactions": "tsx src/migrations/004-billing-transactions.ts",
    "migrate:billing-disclosures": "tsx src/migrations/005-billing-disclosures.ts",
    "migrate:payment-default": "tsx src/migrations/006-default-payment-method.ts",
    "migrate:email-sends": "tsx src/migrations/007-email-sends.ts",
    "migrate:website-connect": "tsx src/migrations/008-website-last-connected.ts",
    "migrate:name-parts": "tsx src/migrations/009-user-name-parts.ts",
    "lint": "eslint .",
    "test": "node --import tsx --test --test-reporter=spec \"src/**/*.test.ts\"",
    "test:watch": "node --import tsx --test --watch \"src/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.test.json",
    "backfill:payment-defaults": "tsx src/scripts/backfill-default-payment-methods.ts",
    "backfill:transactions": "tsx src/scripts/backfill-billing-transactions.ts",
    "backfill:cancellation-flags": "tsx src/scripts/backfill-stale-cancellations.ts",
    "migrations:print": "tsx src/scripts/print-migrations.ts",
    "monitor:ledger-gaps": "tsx src/scripts/check-ledger-gaps.ts",
    "notify": "tsx src/scripts/run-notification-jobs.ts",
    "email:drain": "tsx src/scripts/drain-email-outbox.ts",
    "migrate:target-key": "tsx src/migrations/010-generation-target-key.ts",
    "migrate:iseo-credits": "tsx src/migrations/011-iseo-credit-pool.ts",
    "migrate:credit-lots": "tsx src/migrations/012-credit-lots.ts",
    "migrate:yearly-plans": "tsx src/migrations/013-yearly-plans.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.102.0",
    "@supabase/supabase-js": "^2.78.0",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20.11.30",
    "@types/stripe": "^8.0.416",
    "axios": "^1.7.7",
    "bcrypt": "^6.0.0",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "form-data": "^4.0.5",
    "mailgun.js": "^12.7.1",
    "mongoose": "^8.19.1",
    "multer": "^2.1.1",
    "openai": "^6.3.0",
    "postgres": "^3.4.7",
    "sharp": "^0.34.5",
    "stripe": "^19.2.0",
    "typescript": "^5.6.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/sharp": "^0.31.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "mongodb": "^6.20.0",
    "prettier": "^3.3.3",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.19.0"
  }
}