{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["src/**/*"],
  // Tests and their fakes are excluded from the SHIPPED build only — they are
  // still type-checked, by tsconfig.test.json (`npm run typecheck`). Compiling
  // them into dist/ would ship test doubles to production.
  "exclude": ["node_modules", "dist", "src/**/*.test.ts", "src/test/helpers/**"]
}
